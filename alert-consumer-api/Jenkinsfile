@Library('fraud-pipeline-lib') _

pipeline {
    agent none

    stages {
        stage('Build and test') {
            agent {
                docker {
                    image 'maven:3.9.9-eclipse-temurin-17'
                    args '-v maven-repo:/home/ubuntu/.m2'
                }
            }
            steps {
                mavenBuildAndTest(dir: 'alert-consumer-api')
            }
            post {
                always {
                    mavenBuildAndTestReport(dir: 'alert-consumer-api')
                }
            }
        }

        stage('Docker build') {
            agent { label 'built-in' }
            steps {
                // Build context stays the repo root (not dir-scoped): the Dockerfile
                // needs the sibling schemas/ directory for Avro codegen.
                dockerBuildAndPush(
                    image: 'ghcr.io/diecocan/fraud-detection-kafka-alert-consumer-api',
                    dockerfile: 'alert-consumer-api/Dockerfile'
                )
            }
        }

        stage('Ensure Kafka/MySQL stack is up') {
            agent { label 'built-in' }
            steps {
                ensureComposeStackUp('fraud-detection-kafka')
            }
        }

        stage('Deploy to staging') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'alert-consumer-api-staging',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-alert-consumer-api:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    ports: '-p 8094:8082',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","consumer":{"group-id":"alert-consumer-group-staging","properties":{"schema.registry.url":"http://schema-registry:8081"}}},"datasource":{"url":"jdbc:mysql://mysql:3306/fraud_detection"}}}'
                )
                verifyHttp(sleepSeconds: 15, urls: ['http://host.docker.internal:8094/api/alerts'])
            }
        }

        stage('Approval') {
            steps {
                approvalGate()
            }
        }

        stage('Deploy to production') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'alert-consumer-api-prod',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-alert-consumer-api:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    ports: '-p 8095:8082',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","consumer":{"group-id":"alert-consumer-group-prod","properties":{"schema.registry.url":"http://schema-registry:8081"}}},"datasource":{"url":"jdbc:mysql://mysql:3306/fraud_detection"}}}'
                )
                verifyHttp(sleepSeconds: 15, urls: ['http://host.docker.internal:8095/api/alerts'])
            }
        }
    }
}
