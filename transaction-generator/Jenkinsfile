@Library('fraud-pipeline-lib') _

pipeline {
    agent none

    stages {
        stage('Build and test') {
            agent {
                docker {
                    image 'maven:3.9.9-eclipse-temurin-17'
                    args '-v maven-repo:/home/ubuntu/.m2'
                }
            }
            steps {
                mavenBuildAndTest(dir: 'transaction-generator')
            }
            post {
                always {
                    mavenBuildAndTestReport(dir: 'transaction-generator')
                }
            }
        }

        stage('Docker build') {
            agent { label 'built-in' }
            steps {
                dockerBuildAndPush(
                    image: 'ghcr.io/diecocan/fraud-detection-kafka-transaction-generator',
                    dockerfile: 'transaction-generator/Dockerfile'
                )
            }
        }

        stage('Ensure Kafka/MySQL stack is up') {
            agent { label 'built-in' }
            steps {
                ensureComposeStackUp('fraud-detection-kafka')
            }
        }

        stage('Deploy to staging') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'transaction-generator-staging',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-transaction-generator:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","properties":{"schema.registry.url":"http://schema-registry:8081"}}},"transaction-generator":{"topic":"transactions-staging"}}'
                )
                // No REST endpoint to curl (web-application-type: none) - this is a
                // scheduled background producer, so verify by tailing its own logs
                // for the "Sent transaction" line instead.
                verifyLogs(container: 'transaction-generator-staging', pattern: 'Sent transaction', sleepSeconds: 15)
            }
        }

        stage('Approval') {
            steps {
                approvalGate()
            }
        }

        stage('Deploy to production') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'transaction-generator-prod',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-transaction-generator:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","properties":{"schema.registry.url":"http://schema-registry:8081"}}},"transaction-generator":{"topic":"transactions-prod"}}'
                )
                verifyLogs(container: 'transaction-generator-prod', pattern: 'Sent transaction', sleepSeconds: 15)
            }
        }
    }
}
