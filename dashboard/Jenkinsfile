@Library('fraud-pipeline-lib') _

pipeline {
    agent none

    stages {
        stage('Build and test') {
            agent {
                docker {
                    image 'node:22-alpine'
                    args '-v npm-cache:/home/node/.npm'
                }
            }
            steps {
                nodeBuildAndTest(dir: 'dashboard')
            }
            post {
                always {
                    nodeBuildAndTestReport(dir: 'dashboard')
                }
            }
        }

        stage('Docker build') {
            agent { label 'built-in' }
            steps {
                dockerBuildAndPush(image: 'ghcr.io/diecocan/fraud-detection-kafka-dashboard', dir: 'dashboard')
            }
        }

        stage('Deploy to staging') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'fraud-detection-kafka-dashboard-staging',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-dashboard:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    ports: '-p 8096:80',
                    envVars: [BACKEND_HOST: 'alert-consumer-api-staging', BACKEND_PORT: '8082']
                )
                verifyHttp(sleepSeconds: 5, urls: [
                    'http://host.docker.internal:8096/',
                    'http://host.docker.internal:8096/api/alerts/stats'
                ])
            }
        }

        stage('Approval') {
            steps {
                approvalGate()
            }
        }

        stage('Deploy to production') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'fraud-detection-kafka-dashboard-prod',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-dashboard:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    ports: '-p 8097:80',
                    envVars: [BACKEND_HOST: 'alert-consumer-api-prod', BACKEND_PORT: '8082']
                )
                verifyHttp(sleepSeconds: 5, urls: [
                    'http://host.docker.internal:8097/',
                    'http://host.docker.internal:8097/api/alerts/stats'
                ])
            }
        }
    }
}
