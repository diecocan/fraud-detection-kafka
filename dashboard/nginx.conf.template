server {
    listen 80;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        # /api/alerts/stream is Server-Sent Events - buffering would hold
        # events until the response closes instead of streaming them live.
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
