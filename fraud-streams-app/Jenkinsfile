@Library('fraud-pipeline-lib') _

pipeline {
    agent none

    stages {
        stage('Build and test') {
            agent {
                docker {
                    image 'maven:3.9.9-eclipse-temurin-17'
                    args '-v maven-repo:/home/ubuntu/.m2'
                }
            }
            steps {
                mavenBuildAndTest(dir: 'fraud-streams-app')
            }
            post {
                always {
                    mavenBuildAndTestReport(dir: 'fraud-streams-app')
                }
            }
        }

        stage('Docker build') {
            agent { label 'built-in' }
            steps {
                dockerBuildAndPush(
                    image: 'ghcr.io/diecocan/fraud-detection-kafka-fraud-streams-app',
                    dockerfile: 'fraud-streams-app/Dockerfile'
                )
            }
        }

        stage('Ensure Kafka/MySQL stack is up') {
            agent { label 'built-in' }
            steps {
                ensureComposeStackUp('fraud-detection-kafka')
            }
        }

        stage('Deploy to staging') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'fraud-streams-app-staging',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-fraud-streams-app:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","streams":{"application-id":"fraud-streams-app-staging","properties":{"schema.registry.url":"http://schema-registry:8081"}}}},"fraud-streams-app":{"topics":{"transactions":"transactions-staging","account-profiles":"account-profiles-staging","alerts":"alerts-staging"}}}'
                )
                // No REST endpoint to curl (web-application-type: none) - verify by
                // tailing logs for the KafkaStreams client reaching RUNNING state.
                verifyLogs(
                    container: 'fraud-streams-app-staging',
                    pattern: 'stream-client .* State transition from REBALANCING to RUNNING',
                    sleepSeconds: 20
                )
            }
        }

        stage('Approval') {
            steps {
                approvalGate()
            }
        }

        stage('Deploy to production') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'fraud-streams-app-prod',
                    image: "ghcr.io/diecocan/fraud-detection-kafka-fraud-streams-app:${env.GIT_COMMIT}",
                    network: 'fraud-detection-kafka_default',
                    envJson: '{"spring":{"kafka":{"bootstrap-servers":"kafka:9093","streams":{"application-id":"fraud-streams-app-prod","properties":{"schema.registry.url":"http://schema-registry:8081"}}}},"fraud-streams-app":{"topics":{"transactions":"transactions-prod","account-profiles":"account-profiles-prod","alerts":"alerts-prod"}}}'
                )
                verifyLogs(
                    container: 'fraud-streams-app-prod',
                    pattern: 'stream-client .* State transition from REBALANCING to RUNNING',
                    sleepSeconds: 20
                )
            }
        }
    }
}
